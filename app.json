{
  "expo": {
    "name": "mobile-app",
    "slug": "mobile-app",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mobileapp",
      "infoPlist": {
        "NSCameraUsageDescription": "This app requires camera access for face verification during account setup.",
        "NSPhotoLibraryUsageDescription": "This app requires photo library access for face verification."
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
    "package": "com.mobileapp",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "runtimeVersion": "1.0.0"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera for face verification."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos for face verification."
        }
      ],
      "expo-router"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "0221a029-c5e5-43cf-8cf3-ec8dd78f7468"
      }
    },
    "owner": "aarishk123",
    "updates": {
      "url": "https://u.expo.dev/0221a029-c5e5-43cf-8cf3-ec8dd78f7468"
    }
  }
}
